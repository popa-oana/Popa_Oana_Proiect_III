@model IEnumerable<Proiect_Netficks.Models.User>
@using Microsoft.AspNetCore.Identity
@inject UserManager<Proiect_Netficks.Models.User> UserManager

@{
    ViewData["Title"] = "Gestionare Utilizatori";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark text-white shadow-lg border-danger">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h1 class="display-4 mb-0">Gestionare Utilizatori</h1>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left me-2"></i>Înapoi la Panou
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Lista Utilizatorilor</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nume</th>
                            <th>Email</th>
                            <th>Tip Abonament</th>
                            <th>Data Înregistrare</th>
                            <th>Roluri</th>
                            <th>Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = await UserManager.GetRolesAsync(user);
                            <tr>
                                <td>@user.Nume</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-@(user.Tip_Abonament == "Premium" ? "danger" : "secondary")">
                                        @user.Tip_Abonament
                                    </span>
                                </td>
                                <td>@user.Data_Inregistrare.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @foreach (var role in roles)
                                    {
                                        <span class="badge bg-dark me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editSubscriptionModal" 
                                                data-user-id="@user.Id" data-user-name="@user.Nume" data-current-plan="@user.Tip_Abonament"
                                                @(await UserManager.IsInRoleAsync(user, "Admin") ? "disabled" : "")>
                                            <i class="bi bi-pencil"></i> Abonament
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal" 
                                                data-user-id="@user.Id" data-user-name="@user.Nume"
                                                @(await UserManager.IsInRoleAsync(user, "Admin") ? "disabled" : "")>
                                            <i class="bi bi-trash"></i> Șterge
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Subscription Modal -->
<div class="modal fade" id="editSubscriptionModal" tabindex="-1" aria-labelledby="editSubscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header bg-danger">
                <h5 class="modal-title" id="editSubscriptionModalLabel">Modificare Abonament</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateUserSubscription" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" id="editUserId" />
                    <p>Modifici abonamentul pentru utilizatorul <strong id="editUserName"></strong>.</p>
                    <p>Abonament curent: <span class="badge bg-secondary" id="currentSubscriptionBadge"></span></p>
                    
                    <div class="form-group mb-3">
                        <label for="subscriptionType" class="form-label">Tip abonament nou:</label>
                        <select name="subscriptionType" id="subscriptionType" class="form-select bg-dark text-white">
                            <option value="Basic">Basic</option>
                            <option value="Standard">Standard</option>
                            <option value="Premium">Premium</option>
                        </select>
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i> Schimbarea abonamentului va actualiza automat rolurile și accesul utilizatorului.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                    <button type="submit" class="btn btn-primary">Salvează modificările</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete User Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header bg-danger">
                <h5 class="modal-title" id="deleteUserModalLabel">Confirmare ștergere cont</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="DeleteUser" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="userId" id="deleteUserId" />
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Atenție!</strong> Ești pe cale să ștergi contul utilizatorului <strong id="deleteUserName"></strong>.
                    </div>
                    <p>Această acțiune este <strong>ireversibilă</strong> și va șterge toate datele asociate acestui utilizator, inclusiv:</p>
                    <ul>
                        <li>Informațiile personale</li>
                        <li>Istoricul de vizionări</li>
                        <li>Lista de favorite</li>
                        <li>Recenziile</li>
                        <li>Abonamentele</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                    <button type="submit" class="btn btn-danger">Șterge definitiv</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle edit subscription modal
            $('#editSubscriptionModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var userId = button.data('user-id');
                var userName = button.data('user-name');
                var currentPlan = button.data('current-plan');
                
                var modal = $(this);
                modal.find('#editUserId').val(userId);
                modal.find('#editUserName').text(userName);
                modal.find('#currentSubscriptionBadge').text(currentPlan);
                modal.find('#subscriptionType').val(currentPlan);
            });
            
            // Handle delete user modal
            $('#deleteUserModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var userId = button.data('user-id');
                var userName = button.data('user-name');
                
                var modal = $(this);
                modal.find('#deleteUserId').val(userId);
                modal.find('#deleteUserName').text(userName);
            });
        });
    </script>
}
