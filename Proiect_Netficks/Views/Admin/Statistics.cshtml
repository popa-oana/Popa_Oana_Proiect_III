@model Proiect_Netficks.Controllers.AdminStatisticsViewModel

@{
    ViewData["Title"] = "Statistici Platformă";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark text-white shadow-lg border-danger">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h1 class="display-4 mb-0">Statistici Platformă</h1>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left me-2"></i>Înapoi la Panou
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card border-danger shadow text-center h-100">
                <div class="card-body text-white">
                    <i class="bi bi-people-fill text-danger" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0">@Model.TotalUsers</h2>
                    <p>Utilizatori Totali</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-danger shadow text-center h-100">
                <div class="card-body text-white">
                    <i class="bi bi-film text-danger" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0">@Model.TotalFilms</h2>
                    <p>Filme</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-danger shadow text-center h-100">
                <div class="card-body text-white">
                    <i class="bi bi-collection-play text-danger" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0">@Model.TotalSeries</h2>
                    <p>Seriale</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card border-danger shadow text-center h-100">
                <div class="card-body text-white">
                    <i class="bi bi-star-fill text-danger" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0">@Model.TotalReviews</h2>
                    <p>Recenzii</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-graph-up me-2"></i>Distribuția Utilizatorilor</h4>
                </div>
                <div class="card-body text-white">
                    <div class="d-flex justify-content-center">
                        <div class="chart-container" style="position: relative; height:300px; width:300px">
                            <canvas id="userDistributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Utilizatori după Tip Abonament</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-dark table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Tip Abonament</th>
                                    <th>Număr Utilizatori</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Premium</td>
                                    <td>@Model.PremiumUsers.Count</td>
                                </tr>
                                <tr>
                                    <td>Standard</td>
                                    <td>@Model.StandardUsers.Count</td>
                                </tr>
                                <tr>
                                    <td>Basic</td>
                                    <td>@Model.BasicUsers.Count</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('userDistributionChart').getContext('2d');
        var myChart = new Chart(ctx, {
            type: 'pie',
            data: {
                labels: ['Premium', 'Standard', 'Basic'],
                datasets: [{
                    data: [@Model.PremiumUsers.Count, @Model.StandardUsers.Count, @Model.BasicUsers.Count],
                    backgroundColor: [
                        '#dc3545',
                        '#fd7e14',
                        '#ffc107'
                    ],
                    borderColor: [
                        '#fff',
                        '#fff',
                        '#fff'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#fff'
                        }
                    }
                }
            }
        });
    </script>
}
